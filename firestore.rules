rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== 輔助函數 ====================

    // 檢查用戶是否已登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 檢查用戶是否為配對成員
    function isCoupleMember(coupleId) {
      return isSignedIn() &&
             request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.member_ids;
    }

    // ==================== 配對 (couples) ====================

    match /couples/{coupleId} {
      // 讀取：只能讀取自己是成員的配對
      allow read: if isSignedIn() &&
                     request.auth.uid in resource.data.member_ids;

      // 新增：只允許已登入用戶建立配對
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.member_ids;

      // 更新：只能更新自己是成員的配對
      allow update: if isSignedIn() &&
                       request.auth.uid in resource.data.member_ids;

      // 刪除：暫不允許刪除配對
      allow delete: if false;
    }

    // ==================== 帳本 (notebooks) ====================

    match /notebooks/{notebookId} {
      // 讀取：只能讀取自己配對的帳本
      allow read: if isSignedIn() &&
                     exists(/databases/$(database)/documents/couples/$(resource.data.couple_id)) &&
                     request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.couple_id)).data.member_ids;

      // 新增：只能新增自己配對的帳本
      allow create: if isSignedIn() &&
                       exists(/databases/$(database)/documents/couples/$(request.resource.data.couple_id)) &&
                       request.auth.uid in get(/databases/$(database)/documents/couples/$(request.resource.data.couple_id)).data.member_ids;

      // 更新/刪除：只能修改/刪除自己配對的帳本
      allow update, delete: if isSignedIn() &&
                               exists(/databases/$(database)/documents/couples/$(resource.data.couple_id)) &&
                               request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.couple_id)).data.member_ids;
    }

    // ==================== 交易記錄 (transactions) ====================

    match /transactions/{transactionId} {
      // 讀取：只能讀取自己配對的交易
      allow read: if isSignedIn() &&
                     exists(/databases/$(database)/documents/couples/$(resource.data.couple_id)) &&
                     request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.couple_id)).data.member_ids;

      // 新增：只能新增自己配對的交易
      allow create: if isSignedIn() &&
                       exists(/databases/$(database)/documents/couples/$(request.resource.data.couple_id)) &&
                       request.auth.uid in get(/databases/$(database)/documents/couples/$(request.resource.data.couple_id)).data.member_ids &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.notebook_id is string &&
                       request.resource.data.amount is number &&
                       request.resource.data.item_name is string;

      // 更新：只能更新自己配對的交易（任一成員都可更新）
      allow update: if isSignedIn() &&
                       exists(/databases/$(database)/documents/couples/$(resource.data.couple_id)) &&
                       request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.couple_id)).data.member_ids;

      // 刪除：只能刪除自己配對的交易（任一成員都可刪除）
      allow delete: if isSignedIn() &&
                       exists(/databases/$(database)/documents/couples/$(resource.data.couple_id)) &&
                       request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.couple_id)).data.member_ids;
    }

    // ==================== 自訂分類 (custom_categories) ====================

    match /custom_categories/{categoryId} {
      // 讀取：只能讀取自己的分類
      allow read: if isSignedIn() &&
                     resource.data.user_id == request.auth.uid;

      // 新增：只能新增自己的分類
      allow create: if isSignedIn() &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.name is string;

      // 更新/刪除：只能修改/刪除自己的分類
      allow update, delete: if isSignedIn() &&
                               resource.data.user_id == request.auth.uid;
    }
  }
}
