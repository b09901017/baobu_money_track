/* ==================== Google Fonts 童話風格字體 ==================== */
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&family=Fredoka:wght@300;400;500;600;700&family=Caveat:wght@400;500;600;700&display=swap');

/* ==================== 基礎設定 ==================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* 童話風格色彩 - 柔和粉彩 */
    --fairy-pink: #FFB5D8;
    --fairy-purple: #D4A5FF;
    --fairy-blue: #A8D8FF;
    --fairy-yellow: #FFF4A3;
    --fairy-peach: #FFD4B8;
    --fairy-mint: #B8F0D8;
    --fairy-lavender: #E8D4FF;

    /* 主題色彩 */
    --primary-color: #FF9EC7;
    --secondary-color: #FFE5F1;
    --accent-color: #D4A5FF;
    --accent-2: #A8D8FF;
    --background: #FFF8F3;
    --surface: #FFFFFF;
    --text-primary: #5D4E6D;
    --text-secondary: #9B8AA8;
    --border-color: #F0D9E7;

    /* 陰影 - 柔和童話感 */
    --shadow-soft: 0 4px 12px rgba(255, 158, 199, 0.15);
    --shadow-medium: 0 6px 20px rgba(212, 165, 255, 0.2);
    --shadow-large: 0 10px 30px rgba(168, 216, 255, 0.25);
    --shadow-book:
        4px 4px 8px rgba(93, 78, 109, 0.15),
        -2px -2px 6px rgba(255, 255, 255, 0.8),
        inset 0 0 0 1px rgba(255, 255, 255, 0.5);

    /* 間距 */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;

    /* 圓角 - 柔和童話感 */
    --radius-sm: 12px;
    --radius-md: 16px;
    --radius-lg: 24px;
    --radius-xl: 32px;
    --radius-full: 50%;
}

body {
    font-family: 'Nunito', 'Microsoft JhengHei', 'PingFang TC', sans-serif;
    background: var(--background);
    color: var(--text-primary);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    position: relative;
}

/* 童話風格背景 - 柔和的點點圖案 */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
        radial-gradient(circle at 20% 30%, rgba(255, 158, 199, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(212, 165, 255, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 40% 80%, rgba(168, 216, 255, 0.06) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

/* ==================== 容器布局 ==================== */
.app-container {
    max-width: 480px;
    margin: 0 auto;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: transparent;
    position: relative;
    overflow: hidden;
    z-index: 1;
}

/* 童話風格頂部 - 雲朵和星星裝飾 */
.app-header {
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-xl);
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
    color: white;
    box-shadow: var(--shadow-medium);
    position: relative;
    overflow: hidden;
}

.app-header::before {
    content: '✨';
    position: absolute;
    top: 12px;
    right: 20px;
    font-size: 1.5rem;
    animation: twinkle 2s infinite;
}

.app-header::after {
    content: '🌙';
    position: absolute;
    top: 12px;
    left: 20px;
    font-size: 1.5rem;
    animation: float 3s ease-in-out infinite;
}

@keyframes twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
}

.notebook-title {
    font-family: 'Fredoka', 'Microsoft JhengHei', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    text-align: center;
    text-shadow: 2px 2px 4px rgba(93, 78, 109, 0.2);
    letter-spacing: 0.5px;
}

.main-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 100px;
    background: transparent;
}

/* ==================== 頁面切換動畫 ==================== */
.page {
    display: none;
    animation: fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.page.active {
    display: block;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* ==================== 首頁 - 結算卡片（童話寶箱風格）==================== */
.balance-card {
    margin: var(--spacing-lg);
    padding: var(--spacing-xl);
    background: linear-gradient(135deg, #FFD4E5 0%, #E5D4FF 50%, #D4E5FF 100%);
    border-radius: var(--radius-xl);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    box-shadow: var(--shadow-large);
    position: relative;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.6);
}

.balance-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
    animation: shimmer 3s linear infinite;
}

@keyframes shimmer {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.balance-icon {
    font-size: 4rem;
    z-index: 1;
    filter: drop-shadow(2px 2px 4px rgba(93, 78, 109, 0.2));
    animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}

.balance-info {
    flex: 1;
    z-index: 1;
}

.balance-label {
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    opacity: 0.8;
    margin-bottom: var(--spacing-xs);
    font-weight: 500;
}

.balance-amount {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.7rem;
    font-weight: 700;
    text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.5);
}

/* ==================== 視圖切換按鈕（童話標籤）==================== */
.view-toggle {
    display: flex;
    gap: var(--spacing-md);
    padding: 0 var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.toggle-btn {
    flex: 1;
    padding: var(--spacing-md) var(--spacing-lg);
    border: none;
    background: white;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    box-shadow: var(--shadow-soft);
    color: var(--text-secondary);
    position: relative;
    overflow: hidden;
}

.toggle-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    opacity: 0;
    transition: opacity 0.3s ease;
}

.toggle-btn.active::before {
    opacity: 1;
}

.toggle-btn.active {
    color: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
}

.toggle-btn .icon {
    font-size: 1.4rem;
    z-index: 1;
}

.toggle-btn span:not(.icon) {
    z-index: 1;
}

/* ==================== 交易列表（童話卡片）==================== */
.recent-transactions {
    padding: 0 var(--spacing-lg);
}

.section-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.section-title::before {
    content: '📖';
    font-size: 1.5rem;
}

.transaction-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.transaction-item {
    background: white;
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
}

.transaction-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--primary-color), var(--accent-color));
    opacity: 0;
    transition: opacity 0.3s ease;
}

.transaction-item:hover::before {
    opacity: 1;
}

.transaction-item:active {
    transform: scale(0.98);
}

.transaction-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    background: linear-gradient(135deg, var(--secondary-color), var(--fairy-lavender));
    box-shadow: inset 0 2px 8px rgba(255, 255, 255, 0.5);
}

.transaction-info {
    flex: 1;
}

.transaction-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    color: var(--text-primary);
}

.transaction-meta {
    display: flex;
    gap: var(--spacing-md);
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.transaction-amount {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary-color);
}

.btn-load-more {
    width: 100%;
    margin-top: var(--spacing-md);
    padding: var(--spacing-lg);
    background: white;
    border: 3px dashed var(--border-color);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    cursor: pointer;
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-soft);
}

.btn-load-more:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: var(--secondary-color);
    transform: translateY(-2px);
}

/* ==================== 日曆視圖（童話月曆）==================== */
.calendar-container {
    padding: 0 var(--spacing-lg);
}

.calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-md);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
}

.btn-nav {
    width: 42px;
    height: 42px;
    border: none;
    background: linear-gradient(135deg, var(--fairy-pink), var(--fairy-purple));
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: var(--shadow-soft);
    font-size: 1.2rem;
    color: white;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-nav:hover {
    transform: scale(1.1);
    box-shadow: var(--shadow-medium);
}

.btn-nav:active {
    transform: scale(0.95);
}

#currentMonth {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-md);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
}

.calendar-day {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--background);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: var(--spacing-xs);
    position: relative;
    font-family: 'Fredoka', sans-serif;
}

.calendar-day.header {
    background: transparent;
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.9rem;
    cursor: default;
}

.calendar-day.other-month {
    opacity: 0.3;
}

.calendar-day.today {
    background: linear-gradient(135deg, var(--fairy-yellow), var(--fairy-peach));
    font-weight: 700;
    box-shadow: var(--shadow-soft);
}

.calendar-day.selected {
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    color: white;
    transform: scale(1.05);
    box-shadow: var(--shadow-medium);
}

.calendar-day.has-transaction::after {
    content: '✨';
    position: absolute;
    bottom: 2px;
    font-size: 0.6rem;
}

.day-number {
    font-size: 0.95rem;
    margin-bottom: 2px;
    font-weight: 600;
}

.day-amount {
    font-size: 0.7rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.calendar-day.selected .day-amount {
    color: white;
}

.day-details {
    margin-top: var(--spacing-lg);
    padding: var(--spacing-lg);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
}

#selectedDate {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: var(--text-primary);
}

/* ==================== 帳本列表（童話繪本書架）==================== */
.notebooks-container,
.analytics-container {
    padding: var(--spacing-lg);
}

.page-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: var(--spacing-xl);
    color: var(--text-primary);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
}

.page-title::before {
    content: '📚';
    font-size: 2rem;
}

.notebooks-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
}

/* 繪本書皮效果 */
.notebook-item {
    aspect-ratio: 3/4;
    background: linear-gradient(135deg, var(--fairy-pink) 0%, var(--fairy-purple) 100%);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-book);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 3px solid rgba(255, 255, 255, 0.5);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg);
}

/* 書脊效果 */
.notebook-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 12px;
    background: linear-gradient(90deg,
        rgba(0, 0, 0, 0.1) 0%,
        transparent 50%,
        rgba(255, 255, 255, 0.2) 100%);
}

/* 書頁紋理 */
.notebook-item::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-sm);
    pointer-events: none;
}

.notebook-item:nth-child(2) {
    background: linear-gradient(135deg, var(--fairy-blue) 0%, var(--fairy-mint) 100%);
}

.notebook-item:nth-child(3) {
    background: linear-gradient(135deg, var(--fairy-yellow) 0%, var(--fairy-peach) 100%);
}

.notebook-item:nth-child(4) {
    background: linear-gradient(135deg, var(--fairy-lavender) 0%, var(--fairy-pink) 100%);
}

.notebook-item.active {
    transform: translateY(-8px) scale(1.05);
    box-shadow:
        8px 8px 16px rgba(93, 78, 109, 0.2),
        -4px -4px 12px rgba(255, 255, 255, 0.9),
        inset 0 0 0 3px rgba(255, 255, 255, 0.7);
}

.notebook-item:hover {
    transform: translateY(-4px) rotate(-2deg);
}

.notebook-name {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
    color: white;
    text-shadow: 2px 2px 4px rgba(93, 78, 109, 0.3);
    z-index: 1;
    line-height: 1.3;
}

.notebook-meta {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
    margin-top: var(--spacing-sm);
    z-index: 1;
}

/* 新增帳本按鈕 - 虛線書殼 */
.btn-add-notebook {
    aspect-ratio: 3/4;
    background: white;
    border: 3px dashed var(--border-color);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    box-shadow: var(--shadow-soft);
    position: relative;
    overflow: hidden;
}

.btn-add-notebook::before {
    content: '📖';
    font-size: 3rem;
    opacity: 0.5;
}

.btn-add-notebook::after {
    content: '新增篇章';
    font-size: 0.9rem;
}

.btn-add-notebook:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: var(--secondary-color);
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
}

/* ==================== 分析頁面（童話圖表）==================== */
.date-filter {
    display: flex;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-sm);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
}

.filter-btn {
    flex: 1;
    padding: var(--spacing-md);
    border: none;
    background: transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Fredoka', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
}

.filter-btn.active {
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    color: white;
    box-shadow: var(--shadow-soft);
    transform: scale(1.05);
}

.stats-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
}

.stat-card {
    background: white;
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    text-align: center;
    border: 2px solid var(--border-color);
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
}

.stat-label {
    font-family: 'Fredoka', sans-serif;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-sm);
    font-weight: 500;
}

.stat-value {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.chart-container {
    background: white;
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    margin-bottom: var(--spacing-lg);
    border: 2px solid var(--border-color);
}

.category-breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.category-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: var(--background);
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
}

.category-item:hover {
    background: var(--secondary-color);
    transform: translateX(4px);
}

.category-color {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-soft);
}

.category-name {
    flex: 1;
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    font-weight: 500;
}

.category-amount {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--text-primary);
}

.category-percent {
    font-size: 0.9rem;
    color: var(--text-secondary);
    min-width: 50px;
    text-align: right;
}

/* ==================== 底部導航欄（童話標籤頁）==================== */
.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    max-width: 480px;
    width: 100%;
    display: flex;
    justify-content: space-around;
    background: white;
    border-top: none;
    padding: var(--spacing-sm) 0 var(--spacing-md);
    box-shadow: 0 -8px 24px rgba(93, 78, 109, 0.1);
    z-index: 100;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--spacing-sm);
    color: var(--text-secondary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: var(--radius-md);
    position: relative;
}

.nav-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
    border-radius: 0 0 3px 3px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.nav-item.active::before {
    opacity: 1;
}

.nav-item.active {
    color: var(--primary-color);
}

.nav-item:active {
    transform: scale(0.95);
}

.nav-icon {
    font-size: 1.6rem;
    transition: transform 0.3s ease;
}

.nav-item.active .nav-icon {
    transform: scale(1.1);
}

.nav-label {
    font-family: 'Fredoka', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
}

/* ==================== 浮動按鈕（童話魔法按鈕）==================== */
.fab {
    position: fixed;
    bottom: 100px;
    right: calc(50% - 220px);
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-large);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 3px solid rgba(255, 255, 255, 0.5);
}

.fab::before {
    content: '✨';
    position: absolute;
    top: -8px;
    right: -8px;
    font-size: 1.2rem;
    animation: sparkle 1.5s ease-in-out infinite;
}

@keyframes sparkle {
    0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
    50% { opacity: 0.5; transform: scale(1.2) rotate(180deg); }
}

.fab:hover {
    transform: scale(1.1) rotate(90deg);
    box-shadow: 0 12px 40px rgba(255, 158, 199, 0.4);
}

.fab:active {
    transform: scale(0.95) rotate(90deg);
}

.fab-icon {
    font-size: 2.2rem;
    font-weight: 300;
}

/* ==================== Bottom Sheet（童話彈窗）==================== */
.bottom-sheet {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
}

.bottom-sheet.active {
    display: block;
}

.bottom-sheet-overlay {
    position: absolute;
    inset: 0;
    background: rgba(93, 78, 109, 0.6);
    backdrop-filter: blur(4px);
    animation: fadeInOverlay 0.3s ease;
}

.bottom-sheet-content {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    max-width: 480px;
    width: 100%;
    max-height: 90vh;
    background: white;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    overflow-y: auto;
    animation: slideUpBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 -8px 32px rgba(93, 78, 109, 0.2);
}

@keyframes slideUpBounce {
    0% {
        transform: translateX(-50%) translateY(100%);
    }
    70% {
        transform: translateX(-50%) translateY(-10px);
    }
    100% {
        transform: translateX(-50%) translateY(0);
    }
}

.sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-xl) var(--spacing-lg);
    border-bottom: 2px solid var(--border-color);
    position: sticky;
    top: 0;
    background: white;
    z-index: 1;
}

.sheet-header h3 {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
}

.btn-close {
    width: 40px;
    height: 40px;
    border: none;
    background: linear-gradient(135deg, var(--fairy-pink), var(--fairy-purple));
    border-radius: var(--radius-full);
    cursor: pointer;
    font-size: 1.3rem;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-soft);
}

.btn-close:hover {
    transform: rotate(90deg) scale(1.1);
}

.btn-close:active {
    transform: rotate(90deg) scale(0.9);
}

/* ==================== 表單樣式（童話輸入框）==================== */
.transaction-form {
    padding: var(--spacing-xl) var(--spacing-lg);
}

.form-group {
    margin-bottom: var(--spacing-xl);
}

.form-label {
    display: block;
    font-family: 'Fredoka', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.form-label::before {
    content: '✨';
    font-size: 1rem;
}

.button-group {
    display: flex;
    gap: var(--spacing-sm);
}

.btn-option {
    flex: 1;
    padding: var(--spacing-md) var(--spacing-lg);
    border: 2px solid var(--border-color);
    background: white;
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    box-shadow: var(--shadow-soft);
}

.btn-option:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
}

.btn-option.active {
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    color: white;
    border-color: transparent;
    transform: scale(1.05);
}

.form-input {
    width: 100%;
    padding: var(--spacing-md) var(--spacing-lg);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    transition: all 0.3s ease;
    background: white;
    color: var(--text-primary);
    box-shadow: var(--shadow-soft);
}

.form-input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 4px rgba(255, 158, 199, 0.2);
    transform: translateY(-2px);
}

.tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
}

.tag-btn {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 2px solid var(--border-color);
    background: white;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Fredoka', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    box-shadow: var(--shadow-soft);
}

.tag-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
}

.tag-btn.active {
    background: linear-gradient(135deg, var(--secondary-color), var(--fairy-lavender));
    border-color: var(--primary-color);
    color: var(--primary-color);
    font-weight: 600;
    transform: scale(1.05);
}

.photo-upload {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.btn-upload {
    padding: var(--spacing-lg);
    border: 3px dashed var(--border-color);
    background: var(--background);
    border-radius: var(--radius-lg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    transition: all 0.3s ease;
    font-family: 'Fredoka', sans-serif;
    font-weight: 500;
    color: var(--text-secondary);
}

.btn-upload:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: var(--secondary-color);
    transform: translateY(-2px);
}

.btn-upload .icon {
    font-size: 2rem;
}

.photo-preview {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
}

.preview-image {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    object-fit: cover;
    border: 3px solid white;
    box-shadow: var(--shadow-soft);
}

.btn-primary {
    width: 100%;
    padding: var(--spacing-lg);
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    font-family: 'Fredoka', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-medium);
    border: 3px solid rgba(255, 255, 255, 0.3);
}

.btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-large);
}

.btn-primary:active {
    transform: translateY(-2px) scale(0.98);
}

.btn-submit {
    margin-top: var(--spacing-lg);
}

/* ==================== 響應式設計 ==================== */
@media (max-width: 480px) {
    .fab {
        right: var(--spacing-lg);
    }

    .notebooks-list {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 481px) {
    .fab {
        right: calc(50% - 220px);
    }
}

/* ==================== 滾動條樣式（童話風格）==================== */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--background);
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--primary-color), var(--accent-color));
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, var(--accent-color), var(--primary-color));
}

/* ==================== 視圖容器動畫 ==================== */
.view-container {
    display: none;
}

.view-container.active {
    display: block;
    animation: fadeInSlide 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeInSlide {
    from {
        opacity: 0;
        transform: translateX(-20px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}
